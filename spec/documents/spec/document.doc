                    <br/>
                    <p style="page-break-after:auto" class="MsoNormal"><a name="_b2884b48-a0c1-0cfa-ad22-b93447f16750" id="_b2884b48-a0c1-0cfa-ad22-b93447f16750"></a>/req/core/Coordinate_Reference_System_Types</p>
                    <br/>
                    <p style="page-break-after:auto" class="MsoNormal"><a name="_ad84b1ec-1dcf-f08b-acb4-4713ddfa4508" id="_ad84b1ec-1dcf-f08b-acb4-4713ddfa4508"></a>/req/core/Coordinate_Reference_System_Properties</p>
